//------------------------------------------------------------------------------------------------------------------
//--- 010 Editor v14.0 Template File
//
// File:	  BLP.bt
// Author:	  Alastor Strix'Efuartus
// Purpose:   Parses a Blizzard BLP(.blp)
// Version:   1.1.2
// Category:  Game
// File Mask: *.blp
// ID Bytes:  42 4C 50 32, 42 4C 50 31 //BLP2, BLP1
//	 History: BLP files store textures with precalculated mipmaps. BLP files are capable of storing data with a few different formats
//	 1.1.2 2025-10-15 Alastor: Fix in HeaderData
//	 1.1.1 2024-11-14 Alastor: Mipmap Size/Offset reading inline
//	 1.1.0 2024-11-10 Alastor: Added lots of Enums/Coloring/Failchecks etc...
//	 1.0.0 2024-09-18 Alastor: Initial commit
//------------------------------------------------------------------------------------------------------------------

typedef enum <ubyte>{
    ACBD_0 = 0x0,
    ACBD_1 = 0x1,
    ACBD_2 = 0x2,
    ACBD_4 = 0x4,
    ACBD_5 = 0x8
}E_AlphaChannelBitDepth;

typedef enum<ubyte>{
    PIXEL_DXT1 = 0,
    PIXEL_DXT3 = 1,
    PIXEL_ARGB8888 = 2,
    PIXEL_ARGB1555 = 3,
    PIXEL_ARGB4444 = 4,
    PIXEL_RGB565 = 5,
    PIXEL_A8 = 6,
    PIXEL_DXT5 = 7,
    PIXEL_UNSPECIFIED = 8,
    PIXEL_ARGB2565 = 9,
    PIXEL_BC5 = 11,         // DXGI_FORMAT_BC5_UNORM
    NUM_PIXEL_FORMATS = 12, // (no idea if format=10 exists)
}E_PixelFormat;

typedef enum<ubyte>{
    COLOR_JPEG = 0,            // not supported
    COLOR_PALETTE = 1,
    COLOR_DXT = 2,
    COLOR_ARGB8888 = 3,
    COLOR_ARGB8888_DUP = 4,    // same decompression, likely other PIXEL_FORMAT
}E_Compression;

typedef struct{
	//ubyte ACBD_0_0x0  :1;
	ubyte ACBD_1_0x1  :1;
	ubyte ACBD_2_0x2  :1;
	ubyte ACBD_4_0x4  :1;
	ubyte ACBD_5_0x8  :1;
	ubyte ACBD_6_0x10 :1;
	ubyte ACBD_7_0x20 :1;
	ubyte ACBD_8_0x40 :1;
}sAlphaChannelBitDepth<read=Str("%d", ReadUByte(0x9)), comment="ColorEncoding">; //WIP

typedef uint32 t_MipOffsets<read=MipOffsetsRead, optimize=false>;
typedef uint32 t_MipSizes<read=MipSizeRead, optimize=false>;

string MipOffsetsRead (t_MipOffsets rec){
    string a;
    if(rec==0){
        SPrintf (a, "%u\n", rec);
    }else{
        SPrintf (a, "%u : %LXh\n", rec, rec);
    };
    return a;
};

string MipSizeRead (t_MipOffsets rec){
    string a;
    if(rec==0){
        SPrintf (a, "%u\n", rec);
    }else{
        local float f_rec = rec;
        if(rec>100000){
            SPrintf (a, "%u : %LXh (%g MB)\n", rec, rec, ((f_rec/1024)/1024) );
        }else{
            if(rec>1024){
                SPrintf (a, "%u : %LXh (%g KB)\n", rec, rec, (f_rec/1024) );
            }else{
                SPrintf (a, "%u : %LXh (%g B)\n", rec, rec, f_rec);
            };
        };
    };
    return a;
};

struct{
SetForeColor(0x5050DD);
CHAR BLPMagic[4]; // always 'BLP2' but BLP1 exists
uint32 FormatVersion; // Version, always 1
E_Compression Compression<comment="ColorEncoding">; //1-Uncomp 2-DXTC, 3(cata)-plain A8R8G8B8
//E_AlphaChannelBitDepth AlphaChannelBitDepth; // Alpha channel bit depth: 0, 1 or 8
sAlphaChannelBitDepth AlphaChannelBitDepth; // Alpha channel bit depth: 0, 1 or 8

E_PixelFormat PixelFormat<comment="PrefferdFormat">;

struct{
	//ubyte MIPS_NONE_0x1    :1;
	ubyte MIPS_GENERATED_0x1 :1;
	ubyte MIPS_HANDMADE_0x2  :1;
	ubyte Unk_0x4            :1;
	ubyte Unk_0x8            :1;
	ubyte MIPMAP_MASK_0x10   :1;
	ubyte Unk_0x20           :1;
	ubyte Unk_0x40           :1;
	ubyte Unk_0x80           :1;
}MipmapLvl_FlagType<read=Str("%d", ReadByte(0xB))>; // WIP

uint32 Width;
uint32 Height;
t_MipOffsets MipOffsets[16];
t_MipSizes MipSizes[16];
SetForeColor(cNone);
union{
    struct{
		ubyte B; //0
		ubyte G; //256
		ubyte R; //65536
		ubyte A; //16777216
    }RGB[256]<read=Str("#%02X%02X%02X", this.R, this.G, this.B), fgcolor=(this.R+(this.G*256)+(this.B*65536)), bgcolor=cBlack, optimize=false>;
    struct{
        uint32 headerSize;
        char headerData[1020];
    }JPEG;
}ExtendedData;

local int MipMapCount = 0;
local int n;
local uint Oldpos;

for( n = 0; n <= 15; ++n ){
    if( (MipOffsets[n]>0) && (MipSizes[n]>0) ){
        Oldpos = FTell();
        if( (MipOffsets[n]<FileSize()) && (MipOffsets[n]>0) ){
            FSeek(MipOffsets[n]);
             struct{
                if( ((MipSizes[n]<FileSize()) && (MipSizes[n]>0)) ){
                    ubyte data[MipSizes[n]]<read=Str("%d ", this)>; //Todo refference to pallete
                }else{
                    ubyte data<name="InvalidSize">;
                    Printf("Error in Size ");
                };
            }MipMapLevels<fgcolor=cYellow>;
        }else{
            Printf("Error in Offset: ");
        };
        ++MipMapCount;
        Printf("ID: %d | MipMaps Offset: %8d | Size: %8d \n", n , MipOffsets[n], MipSizes[n] );
    };
};

Printf("MipMaps Count: %d \n", MipMapCount );

}BLP_file<open=true>;